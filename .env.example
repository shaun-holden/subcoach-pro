# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session secret (generate a random string, e.g. openssl rand -hex 32)
SESSION_SECRET=your-secret-here

# Stripe
STRIPE_SECRET_KEY=sk_live_...

# SendGrid
SENDGRID_API_KEY=SG....

# Google Cloud Storage (for file uploads)
PRIVATE_OBJECT_DIR=gs://your-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=gs://your-bucket/public

# Email reminder API key (used to secure /api/send-reminders)
REMINDER_API_KEY=your-reminder-api-key

# Node environment (set automatically by Railway)
NODE_ENV=production
